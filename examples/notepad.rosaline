{
  "version": 8,
  "module": "example.com/rosaline-notepad",
  "actions": [
    {"id": "action-1", "name": "NewAction", "text": "New", "handler": "NewDocument", "shortcut": "Primary+N"},
    {"id": "action-2", "name": "UndoAction", "text": "Undo", "handler": "UndoEdit", "shortcut": "Primary+Z"},
    {"id": "action-3", "name": "RedoAction", "text": "Redo", "handler": "RedoEdit", "shortcut": "Primary+Shift+Z"},
    {"id": "action-4", "name": "CutAction", "text": "Cut", "handler": "CutText", "shortcut": "Primary+X"},
    {"id": "action-5", "name": "CopyAction", "text": "Copy", "handler": "CopyText", "shortcut": "Primary+C"},
    {"id": "action-6", "name": "PasteAction", "text": "Paste", "handler": "PasteText", "shortcut": "Primary+V"},
    {"id": "action-7", "name": "QuitAction", "text": "Quit", "handler": "QuitApplication", "shortcut": "Primary+Q"},
    {"id": "action-8", "name": "AboutAction", "text": "About", "handler": "ShowAbout"}
  ],
  "forms": [
    {
      "id": "form-1",
      "name": "MainForm",
      "title": "Rosaline Notepad",
      "width": 840,
      "height": 620,
      "padding": 10,
      "theme": "Rosaline",
      "root": {
        "id": "root",
        "kind": "Column",
        "component": "MainLayout",
        "children": [
          {
            "id": "node-1",
            "kind": "TextArea",
            "component": "DocumentEditor",
            "name": "Document",
            "height": 520,
            "expand": true
          },
          {
            "id": "node-2",
            "kind": "Label",
            "component": "StatusLabel",
            "text": "Ready"
          }
        ],
        "gap": 8,
        "padding": 8,
        "expand": true
      },
      "events": {
        "OnCloseRequest": "ConfirmClose"
      },
      "menus": [
        {
          "id": "menu-1",
          "kind": "Menu",
          "text": "File",
          "children": [
            {
              "id": "menu-2",
              "kind": "Item",
              "action": "action-1",
              "text": "New"
            },
            {
              "id": "menu-3",
              "kind": "Menu",
              "text": "Samples",
              "children": [
                {
                  "id": "menu-4",
                  "kind": "Item",
                  "text": "Welcome Note",
                  "handler": "OpenWelcomeNote"
                }
              ]
            },
            {
              "id": "menu-5",
              "kind": "Separator"
            },
            {
              "id": "menu-6",
              "kind": "Item",
              "action": "action-7",
              "text": "Quit"
            }
          ]
        },
        {
          "id": "menu-7",
          "kind": "Menu",
          "text": "Edit",
          "children": [
            {
              "id": "menu-8",
              "kind": "Item",
              "action": "action-2",
              "text": "Undo"
            },
            {
              "id": "menu-9",
              "kind": "Item",
              "action": "action-3",
              "text": "Redo"
            },
            {
              "id": "menu-10",
              "kind": "Separator"
            },
            {
              "id": "menu-11",
              "kind": "Item",
              "action": "action-4",
              "text": "Cut"
            },
            {
              "id": "menu-12",
              "kind": "Item",
              "action": "action-5",
              "text": "Copy"
            },
            {
              "id": "menu-13",
              "kind": "Item",
              "action": "action-6",
              "text": "Paste"
            }
          ]
        },
        {
          "id": "menu-14",
          "kind": "Menu",
          "text": "Help",
          "children": [
            {
              "id": "menu-15",
              "kind": "Item",
              "action": "action-8",
              "text": "About"
            }
          ]
        }
      ],
      "toolbar": [
        {"id": "tool-1", "kind": "Action", "action": "action-1"},
        {"id": "tool-2", "kind": "Separator"},
        {"id": "tool-3", "kind": "Action", "action": "action-2"},
        {"id": "tool-4", "kind": "Action", "action": "action-3"},
        {"id": "tool-5", "kind": "Separator"},
        {"id": "tool-6", "kind": "Action", "action": "action-4"},
        {"id": "tool-7", "kind": "Action", "action": "action-5"},
        {"id": "tool-8", "kind": "Action", "action": "action-6"}
      ]
    }
  ],
  "handlers": {
    "ConfirmClose": "return rosaline.Confirm(\"Close Rosaline Notepad?\", \"Any text that has not been copied elsewhere will be lost.\")",
    "NewDocument": "app.Widgets().DocumentEditor.SetText(\"\")\napp.Widgets().StatusLabel.SetText(\"New document\")\napp.Widgets().DocumentEditor.Focus()",
    "OpenWelcomeNote": "app.Widgets().DocumentEditor.SetText(\"Welcome to Rosaline Notepad!\\n\\nThis application, its menus, and these click events were created visually in Rosaline Studio.\")\napp.Widgets().StatusLabel.SetText(\"Loaded welcome note\")",
    "QuitApplication": "rosaline.Quit()",
    "UndoEdit": "app.Widgets().DocumentEditor.Undo()",
    "RedoEdit": "app.Widgets().DocumentEditor.Redo()",
    "CutText": "app.Widgets().DocumentEditor.Cut()",
    "CopyText": "app.Widgets().DocumentEditor.Copy()",
    "PasteText": "app.Widgets().DocumentEditor.Paste()",
    "ShowAbout": "rosaline.Message(\"Rosaline Notepad\", \"A menu-driven application designed visually with Rosaline Studio.\")"
  }
}
